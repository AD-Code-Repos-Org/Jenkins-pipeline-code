pipeline{
    agent{
        label 'linux-node'
    }
    tools{
        maven 'mymaven'
    }
    stages{
        stage('clone the Repo'){
            steps{
                git 'https://github.com/adhongade1/DevOpsClassCodes.git'
            }         
        }
        stage('review the code'){
            steps{
                sh 'mvn pmd:pmd'
            }

         }
         stage('compile the code'){
            steps{
                sh 'mvn compile'
            }
         }
         stage('test the code'){
            steps{
                sh 'mvn test'
            }
         }
         stage('build the package'){
            steps{
                sh 'mvn package'
            }
         }
    }
}