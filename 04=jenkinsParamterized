pipeline{
    agent any
    tools{
        maven 'mymaven'
    }
    parameters{
        choice(name: 'environment', choices: ['dev', 'qa'], description: 'Select the environment')
    }
    stages{
        stage('build code on dev env '){
            //can add agent with label to run the stage on specific node ******
            when{
                    expression{
                        params.environment == 'dev'
                    }
                }
            steps{
                
                git 'https://github.com/Sonal0409/DevOpsCodeDemo.git'
                sh 'mvn pmd:pmd'
                sh 'mvn package'
            }
        }
        stage('build code on qa env '){
            when{
                expression{
                    params.environment == 'qa'
                }
            }
            steps{
                git 'https://github.com/Sonal0409/DevOpsCodeDemo.git'
                sh 'mvn test'
            }
        }
    }
}