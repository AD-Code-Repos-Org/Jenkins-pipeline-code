pipeline{
    agent any
   
    parameters{
        string(name: 'branch', defaultValue: 'main', description: 'Enter the branch name')
        string(name: 'mavenGoals', defaultValue: 'clean install', description: 'Enter the maven goals')
        string(name: 'buildNumber', defaultValue: '1', description: 'Enter the build number')
        choice(name: 'environment', choices: ['dev', 'qa', 'prod'], description: 'Select the environment')
        password(name: 'passwordsd', defaultValue: 'testingpws', description: 'Enter the password')
    }
    environment{
        BUILD_NUMBER = "${params.buildNumber}"
        ENVIRONMENT = "${params.environment}"
        PASSWORD = "${params.password}"
    }

    stages{
        stage('print parameters'){
            steps{
                //git branch: "${params.branch}", url: 'https://github.com/Sonal0409/DevOpsCodeDemo.git'
                echo "Branch name is: ${params.branch}"
                echo "Maven goals are: ${params.mavenGoals}"
                echo "Build number is: ${params.buildNumber}"
                echo "Environment is: ${params.environment}"
                //echo "Password is: ${params.password}"
                
                echo 'The build number is: ' + env.BUILD_NUMBER
                echo "The env ENVIRONMENT " + env.ENVIRONMENT
            }
        }
    }
}